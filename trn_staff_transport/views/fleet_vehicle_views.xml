<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_fleet_vehicle_form_inherit_transport" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.transport</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">

            <!-- 1. Smart Button: Trips (Top Right Box) -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_transport_routes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-road">
                    <field name="trip_count" widget="statinfo" string="Trips"/>
                </button>
            </xpath>

            <!-- 2. Capacity Fields in Model Tab -->
            <xpath expr="//field[@name='seats']" position="after">
                <field name="seat_capacity_override"/>
                <field name="effective_capacity" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>