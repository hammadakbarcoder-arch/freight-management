<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. List View -->
    <record id="view_logistics_transport_vehicle_request_list" model="ir.ui.view">
        <field name="name">logistics.transport.vehicle.request.list</field>
        <field name="model">logistics.transport.vehicle.request</field>
        <field name="arch" type="xml">
            <list string="Vehicle Requests" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-primary="state == 'approved'" decoration-success="state in ('assigned', 'done')" decoration-danger="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="from_datetime"/>
                <field name="to_datetime"/>
                <field name="vehicle_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- 2. Form View -->
    <record id="view_logistics_transport_vehicle_request_form" model="ir.ui.view">
        <field name="name">logistics.transport.vehicle.request.form</field>
        <field name="model">logistics.transport.vehicle.request</field>
        <field name="arch" type="xml">
            <form string="Vehicle Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'submitted'" groups="trn_staff_transport.group_staff_transport_manager"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'submitted'" groups="trn_staff_transport.group_staff_transport_manager"/>
                    <button name="action_assign" string="Assign Vehicle" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_done" string="Mark as Done" type="object" class="btn-success" invisible="state != 'assigned'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,assigned,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request Details">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="from_datetime" readonly="state != 'draft'"/>
                            <field name="to_datetime" readonly="state != 'draft'"/>
                            <field name="purpose" readonly="state != 'draft'"/>
                        </group>
                        <group string="Allocation &amp; Approval">
                            <field name="vehicle_id" readonly="state in ('done', 'cancelled')"/>
                            <field name="approver_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 3. Search View -->
    <record id="view_logistics_transport_vehicle_request_search" model="ir.ui.view">
        <field name="name">logistics.transport.vehicle.request.search</field>
        <field name="model">logistics.transport.vehicle.request</field>
        <field name="arch" type="xml">
            <search string="Search Vehicle Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="vehicle_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requester" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 4. Window Action -->
    <record id="action_logistics_transport_vehicle_request" model="ir.actions.act_window">
        <field name="name">Vehicle Requests</field>
        <field name="res_model">logistics.transport.vehicle.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_transport_vehicle_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Vehicle Request
            </p>
            <p>
                Staff members can request vehicles for company travel with approval workflows.
            </p>
        </field>
    </record>
</odoo>
