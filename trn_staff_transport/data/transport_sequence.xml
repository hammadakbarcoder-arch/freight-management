<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Trips -->
        <record id="seq_transport_trip" model="ir.sequence">
            <field name="name">Transport Trip Sequence</field>
            <field name="code">logistics.transport.trip</field>
            <field name="prefix">TRIP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Vehicle Request -->
        <record id="seq_transport_vehicle_request" model="ir.sequence">
            <field name="name">Vehicle Request Sequence</field>
            <field name="code">logistics.transport.vehicle.request</field>
            <field name="prefix">VR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
