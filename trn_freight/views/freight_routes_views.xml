<odoo>
    <record id="view_freight_routes_list" model="ir.ui.view">
        <field name="name">freight.routes.list</field>
        <field name="model">freight.routes</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="land_price"/>
                <field name="air_price"/>
                <field name="water_price"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_freight_routes_form" model="ir.ui.view">
        <field name="name">freight.routes.form</field>
        <field name="model">freight.routes</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="land_price"/>
                            <field name="air_price"/>
                            <field name="water_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_freight_routes_search" model="ir.ui.view">
        <field name="name">freight.routes.search</field>
        <field name="model">freight.routes</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_freight_routes" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">freight.routes</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>