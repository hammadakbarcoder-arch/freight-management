<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_freight_container_tree" model="ir.ui.view">
        <field name="name">freight.container.list</field>
        <field name="model">freight.container</field>
        <field name="arch" type="xml">
            <list string="Freight Container">
                <field name="name" string="Name"/>
                <field name="active" string="Active" widget="boolean_toggle"/>
                <field name="code" optional="hide"/>
                <field name="size" optional="hide"/>
                <field name="weight" optional="hide"/>
                <field name="volume" optional="hide"/>
                <field name="state" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_freight_container_form" model="ir.ui.view">
        <field name="name">freight.container.form</field>
        <field name="model">freight.container</field>
        <field name="arch" type="xml">
            <form string="Freight Container">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Name"/>
                            <field name="size" string="Size"/>
                            <field name="weight" string="Weight"/>
                            <field name="volume" string="Volume"/>
                        </group>
                        <group>
                            <field name="code" string="Code"/>
                            <field name="size_uom_id" string="Size UOM" options="{'no_create': True, 'no_open': True}"/>
                            <field name="weight_uom_id" string="Weight UOM" options="{'no_create': True, 'no_open': True}"/>
                            <field name="volume_uom_id" string="Volume UOM" options="{'no_create': True, 'no_open': True}"/>
                            <field name="active" string="Active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_freight_container_search" model="ir.ui.view">
        <field name="name">freight.container.search</field>
        <field name="model">freight.container</field>
        <field name="arch" type="xml">
            <search string="Search Containers">
                <field name="name"/>
                <field name="code"/>
                <filter string="Available" name="filter_available" domain="[('state', '=', 'available')]"/>
                <filter string="Reserve" name="filter_reserved" domain="[('state', '=', 'reserved')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_freight_container" model="ir.actions.act_window">
        <field name="name">Freight Container</field>
        <field name="res_model">freight.container</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_freight_container_search"/>
    </record>
</odoo>
