<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_freight_port_list" model="ir.ui.view">
        <field name="name">freight.port.list</field>
        <field name="model">freight.port</field>
        <field name="arch" type="xml">
            <list string="Freight Port">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="code" optional="hide"/>
                <field name="country_id" optional="hide"/>
                <field name="state_id" optional="hide"/>
                <field name="is_land" optional="hide"/>
                <field name="is_air" optional="hide"/>
                <field name="is_water" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_freight_port_form" model="ir.ui.view">
        <field name="name">freight.port.form</field>
        <field name="model">freight.port</field>
        <field name="arch" type="xml">
            <form string="Freight Port">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Lahore"/>
                            <field name="code" placeholder="e.g. PK-LHE"/>
                            <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="state_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="is_land"/>
                            <field name="is_air"/>
                            <field name="is_water"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View with Filters -->
    <record id="view_freight_port_search" model="ir.ui.view">
        <field name="name">freight.port.search</field>
        <field name="model">freight.port</field>
        <field name="arch" type="xml">
            <search string="Search Ports">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <separator/>
                <filter string="Land" name="filter_land" domain="[('is_land', '=', True)]"/>
                <filter string="Air" name="filter_air" domain="[('is_air', '=', True)]"/>
                <filter string="Water" name="filter_water" domain="[('is_water', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_freight_port" model="ir.actions.act_window">
        <field name="name">Freight Port</field>
        <field name="res_model">freight.port</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_freight_port_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Freight Port!
            </p>
        </field>
    </record>
</odoo>
