<odoo>
    <record id="view_freight_service_list" model="ir.ui.view">
        <field name="name">freight.service.list</field>
        <field name="model">freight.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sale_price"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_freight_service_form" model="ir.ui.view">
        <field name="name">freight.service.form</field>
        <field name="model">freight.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sale_price"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vendors" name="vendors">
                            <field name="vendor_line_ids">
                                <list editable="bottom">
                                    <field name="vendor_id"/>
                                    <field name="sale_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_freight_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">freight.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--<menuitem id="menu_freight_service"
              name="Services"
              parent="menu_freight_configuration"
              action="action_freight_service"
              sequence="40"/>-->
</odoo>