<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="trn_freight_dashboard.FreightDashboard">
        <div t-attf-class="o_freight_dashboard_container #{state.is_dark_mode ? 'o_dark_mode' : ''}">

            <!-- ======================================================== -->
            <!-- 1. TOP HEADER & FILTER BAR                               -->
            <!-- ======================================================== -->
            <div class="o_dash_header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="o_dash_title_icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <rect x="3" y="3" width="8" height="8" rx="2"/>
                            <rect x="13" y="3" width="8" height="8" rx="2"/>
                            <rect x="3" y="13" width="8" height="8" rx="2"/>
                            <rect x="13" y="13" width="8" height="8" rx="2"/>
                        </svg>
                    </div>
                    <h3 class="o_dash_title mb-0">Freight Dashboard</h3>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <!-- Date Presets Pill -->
                    <div class="o_date_pill_group d-flex align-items-center">
                        <button type="button"
                                t-attf-class="o_pill_btn #{state.active_filter_preset === 'today' ? 'active' : ''}"
                                t-on-click="() => this.selectPreset('today')">
                            Today
                        </button>
                        <button type="button"
                                t-attf-class="o_pill_btn #{state.active_filter_preset === 'weekly' ? 'active' : ''}"
                                t-on-click="() => this.selectPreset('weekly')">
                            Weekly
                        </button>
                        <button type="button"
                                t-attf-class="o_pill_btn #{state.active_filter_preset === '12m' ? 'active' : ''}"
                                t-on-click="() => this.selectPreset('12m')">
                            12M
                        </button>
                        <button type="button"
                                t-attf-class="o_pill_btn #{state.active_filter_preset === 'all' ? 'active' : ''}"
                                t-on-click="() => this.selectPreset('all')">
                            All
                        </button>
                    </div>

                    <!-- Dark Mode Toggle Button -->
                    <button type="button"
                            class="btn o_theme_toggle_btn rounded-circle"
                            t-on-click="() => this.toggleDarkMode()"
                            title="Toggle Light/Dark Theme">
                        <i t-attf-class="fa #{state.is_dark_mode ? 'fa-sun-o' : 'fa-moon-o'}"/>
                    </button>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- 2. SIX (6) TOP KPI METRIC CARDS                           -->
            <!-- ======================================================== -->
            <div class="o_dash_kpi_grid mb-3">
                <!-- KPI 1: Total Shipments -->
                <div class="o_kpi_card d-flex align-items-center gap-3 p-3"
                     t-on-click="() => this.openOrders('active', 'Total Shipments')">
                    <div class="o_kpi_icon_box bg-purple">
                        <i class="fa fa-cube"/>
                    </div>
                    <div class="o_kpi_content">
                        <h4 class="o_kpi_value mb-0" t-out="state.active_orders || state.total_orders"/>
                        <span class="o_kpi_label">Total Shipments</span>
                    </div>
                </div>

                <!-- KPI 2: In Transit -->
                <div class="o_kpi_card d-flex align-items-center gap-3 p-3"
                     t-on-click="() => this.openAllShipments([['state', 'in', ['submitted', 'confirmed']]], 'In Transit Shipments')">
                    <div class="o_kpi_icon_box bg-blue">
                        <i class="fa fa-truck"/>
                    </div>
                    <div class="o_kpi_content">
                        <h4 class="o_kpi_value mb-0" t-out="state.in_transit_orders"/>
                        <span class="o_kpi_label">In Transit</span>
                    </div>
                </div>

                <!-- KPI 3: Delivered -->
                <div class="o_kpi_card d-flex align-items-center gap-3 p-3"
                     t-on-click="() => this.openOrdersByState('done', 'Delivered Shipments')">
                    <div class="o_kpi_icon_box bg-green">
                        <i class="fa fa-check-circle"/>
                    </div>
                    <div class="o_kpi_content">
                        <h4 class="o_kpi_value mb-0" t-out="state.delivered_orders"/>
                        <span class="o_kpi_label">Delivered</span>
                    </div>
                </div>

                <!-- KPI 4: Awaiting Action -->
                <div class="o_kpi_card d-flex align-items-center gap-3 p-3"
                     t-on-click="() => this.openOrdersByState('draft', 'Awaiting Action Shipments')">
                    <div class="o_kpi_icon_box bg-amber">
                        <i class="fa fa-clock-o"/>
                    </div>
                    <div class="o_kpi_content">
                        <h4 class="o_kpi_value mb-0" t-out="state.awaiting_action_orders"/>
                        <span class="o_kpi_label">Awaiting Action</span>
                    </div>
                </div>

                <!-- KPI 5: Total Revenue -->
                <div class="o_kpi_card d-flex align-items-center gap-3 p-3"
                     t-att-title="formatCurrency(state.total_revenue)"
                     t-on-click="() => this.openAllShipments([['state', 'in', ['invoiced', 'done']]], 'Revenue Shipments')">
                    <div class="o_kpi_icon_box bg-red">
                        <i class="fa fa-file-text-o"/>
                    </div>
                    <div class="o_kpi_content">
                        <h4 class="o_kpi_value mb-0" t-out="formatCompact(state.total_revenue)"/>
                        <span class="o_kpi_label">Total Revenue</span>
                    </div>
                </div>

                <!-- KPI 6: Profit Margin -->
                <div class="o_kpi_card d-flex align-items-center gap-3 p-3">
                    <div class="o_kpi_icon_box bg-teal">
                        <i class="fa fa-percent"/>
                    </div>
                    <div class="o_kpi_content">
                        <h4 class="o_kpi_value mb-0"><t t-out="state.profit_margin_pct"/>%</h4>
                        <span class="o_kpi_label">Profit Margin</span>
                    </div>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- 3. MIDDLE ROW: 4 ANALYTIC CARDS                           -->
            <!-- ======================================================== -->
            <div class="o_dash_middle_grid mb-3">

                <!-- 3.1 Shipment Status (Donut Chart) -->
                <div class="o_dash_card o_accent_cyan h-100 d-flex flex-column p-4">
                    <h6 class="o_card_title mb-3">Shipment Status</h6>

                    <div class="o_donut_wrapper d-flex flex-column align-items-center justify-content-center flex-grow-1">
                        <div class="o_donut_box position-relative">
                            <svg viewBox="0 0 100 100" class="o_donut_svg">
                                <circle cx="50" cy="50" r="38" fill="transparent" stroke="#f1f5f9" stroke-width="12"/>
                                <t t-foreach="statusSegments" t-as="seg" t-key="seg.key">
                                    <circle cx="50" cy="50" r="38"
                                            fill="transparent"
                                            t-att-stroke="seg.color"
                                            stroke-width="12"
                                            t-att-stroke-dasharray="seg.dasharray"
                                            t-att-stroke-dashoffset="seg.dashoffset"
                                            class="o_donut_seg"
                                            t-on-click="() => this.openOrders(seg.key, seg.label + ' Orders')"/>
                                </t>
                            </svg>
                            <div class="o_donut_center_text text-center">
                                <div class="fs-4 fw-bold text-dark o_center_num" t-out="state.total_orders"/>
                                <div class="small text-muted" style="font-size: 11px;">Total</div>
                            </div>
                        </div>

                        <div class="text-center mt-3">
                            <div class="fw-bold" style="font-size: 13px;">Shipment mix</div>
                            <div class="text-muted" style="font-size: 11px;">Live distribution across all shipment states.</div>
                        </div>

                        <!-- Legend Pills -->
                        <div class="o_status_legend d-flex flex-wrap justify-content-center gap-3 mt-3">
                            <t t-foreach="statusSegments" t-as="seg" t-key="seg.key">
                                <div class="d-flex align-items-center gap-1 cursor-pointer"
                                     t-on-click="() => this.openOrders(seg.key, seg.label + ' Orders')">
                                    <span class="o_legend_bar" t-attf-style="background-color: {{ seg.color }};"/>
                                    <span class="text-muted small" t-out="seg.label"/>
                                    <span class="fw-bold small" t-out="seg.count"/>
                                </div>
                            </t>
                        </div>

                        <!-- Bottom Metrics Box -->
                        <div class="o_sub_metrics_box d-flex justify-content-around w-100 p-2 mt-3 rounded">
                            <div class="text-center">
                                <div class="text-muted" style="font-size: 10px;">Tracked States</div>
                                <div class="fw-bold fs-6" t-out="state.tracked_states_count"/>
                            </div>
                            <div class="text-center">
                                <div class="text-muted" style="font-size: 10px;">Delivered Rate</div>
                                <div class="fw-bold fs-6"><t t-out="state.delivered_rate_pct"/>%</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3.2 Revenue vs Expense Area Chart -->
                <div class="o_dash_card o_accent_gradient h-100 p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="o_card_title mb-0">Revenue vs Expense</h6>
                        <div class="d-flex align-items-center gap-3 small">
                            <div class="d-flex align-items-center gap-1">
                                <span class="o_dot" style="background-color: #8b5cf6;"/>
                                <span class="text-muted">Revenue</span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="o_dot" style="background-color: #f43f5e;"/>
                                <span class="text-muted">Expense</span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="o_dot" style="background-color: #10b981;"/>
                                <span class="text-muted">Profit</span>
                            </div>
                        </div>
                    </div>

                    <!-- 3 Metric Numbers Row -->
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <div class="text-muted small" style="font-size: 11px;">Revenue</div>
                            <div class="fw-bold fs-6 o_metric_num text-dark" t-out="formatCurrency(state.total_revenue)"/>
                        </div>
                        <div class="col-4">
                            <div class="text-muted small" style="font-size: 11px;">Expense</div>
                            <div class="fw-bold fs-6 o_metric_num text-dark" t-out="formatCurrency(state.total_expense)"/>
                        </div>
                        <div class="col-4">
                            <div class="text-muted small" style="font-size: 11px;">Profit</div>
                            <div class="fw-bold fs-6 o_metric_num text-dark" t-out="formatCurrency(state.net_margin)"/>
                        </div>
                    </div>

                    <!-- SVG 12-Month Area Chart -->
                    <div class="o_chart_wrapper flex-grow-1 position-relative" style="min-height: 190px;">
                        <svg viewBox="0 0 580 210" class="w-100 h-100 o_area_svg" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="oRevGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.32"/>
                                    <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.02"/>
                                </linearGradient>
                            </defs>

                            <!-- Horizontal Grid Lines & Y-Labels -->
                            <t t-foreach="chartConfig.yTicks" t-as="tick" t-key="tick.val">
                                <line t-att-x1="chartConfig.padL"
                                      t-att-y1="tick.y"
                                      x2="560"
                                      t-att-y2="tick.y"
                                      stroke="#e2e8f0"
                                      stroke-dasharray="3,3"
                                      stroke-width="1"/>
                                <text t-att-x="chartConfig.padL - 8"
                                      t-att-y="tick.y + 4"
                                      text-anchor="end"
                                      font-size="10"
                                      fill="#94a3b8"
                                      t-out="tick.label"/>
                            </t>

                            <!-- Shaded Revenue Area -->
                            <path t-att-d="chartConfig.revAreaPath" fill="url(#oRevGrad)"/>

                            <!-- Revenue Spline Line -->
                            <path t-att-d="chartConfig.revLinePath" fill="none" stroke="#8b5cf6" stroke-width="2.5"/>

                            <!-- Expense Spline Line -->
                            <path t-att-d="chartConfig.expLinePath" fill="none" stroke="#f43f5e" stroke-width="2"/>

                            <!-- Profit Spline Line -->
                            <path t-att-d="chartConfig.prfLinePath" fill="none" stroke="#10b981" stroke-width="1.8" stroke-dasharray="4,2"/>

                            <!-- Points on Revenue Line -->
                            <t t-foreach="chartConfig.revPoints" t-as="pt" t-key="pt.month">
                                <circle t-att-cx="pt.x"
                                        t-att-cy="pt.y"
                                        r="3.5"
                                        fill="#8b5cf6"
                                        stroke="#ffffff"
                                        stroke-width="1.5"
                                        t-att-title="pt.month + ' Revenue: ' + formatCurrency(pt.val)"/>
                            </t>

                            <!-- Points on Expense Line -->
                            <t t-foreach="chartConfig.expPoints" t-as="pt" t-key="pt.month">
                                <circle t-att-cx="pt.x"
                                        t-att-cy="pt.y"
                                        r="3"
                                        fill="#f43f5e"
                                        stroke="#ffffff"
                                        stroke-width="1.5"
                                        t-att-title="pt.month + ' Expense: ' + formatCurrency(pt.val)"/>
                            </t>

                            <!-- X Axis Month Labels -->
                            <t t-foreach="chartConfig.xLabels" t-as="xl" t-key="xl.label">
                                <text t-att-x="xl.x"
                                      y="200"
                                      text-anchor="middle"
                                      font-size="10"
                                      font-weight="600"
                                      fill="#64748b"
                                      t-out="xl.label"/>
                            </t>
                        </svg>
                    </div>
                </div>

                <!-- 3.3 Shipments by Top Routes -->
                <div class="o_dash_card o_accent_orange h-100 p-3 d-flex flex-column">
                    <h6 class="o_card_title mb-3">Shipments by Top Routes</h6>

                    <div class="d-flex flex-column gap-3 flex-grow-1">
                        <t t-if="state.top_routes and state.top_routes.length">
                            <t t-foreach="state.top_routes" t-as="route" t-key="route.name">
                                <div class="o_route_item cursor-pointer"
                                     t-on-click="() => this.openRouteShipments(route)">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="o_route_name text-truncate" t-att-title="route.name" t-out="route.name"/>
                                        <span class="o_route_count fw-bold small" t-out="route.count"/>
                                    </div>
                                    <div class="o_progress_track">
                                        <div class="o_progress_fill"
                                             t-attf-style="width: {{ route.percentage }}%; background-color: {{ route.color }};"/>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="text-muted small text-center my-auto">No routes recorded yet.</div>
                        </t>
                    </div>
                </div>

                <!-- 3.4 Booking Pipeline -->
                <div class="o_dash_card o_accent_blue h-100 p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h6 class="o_card_title mb-3">Booking Pipeline</h6>
                        <div class="o_pipeline_list d-flex flex-column gap-2 mb-3">
                            <div class="o_pipe_row border-gray d-flex justify-content-between align-items-center px-2 py-1 cursor-pointer"
                                 t-on-click="() => this.openOrdersByState('draft', 'Draft Bookings')">
                                <span class="small">Draft</span>
                                <span class="fw-bold small" t-out="state.booking_pipeline.draft"/>
                            </div>
                            <div class="o_pipe_row border-blue d-flex justify-content-between align-items-center px-2 py-1 cursor-pointer"
                                 t-on-click="() => this.openOrdersByState('submitted', 'Submitted Bookings')">
                                <span class="small">Submitted</span>
                                <span class="fw-bold small" t-out="state.booking_pipeline.submitted"/>
                            </div>
                            <div class="o_pipe_row border-amber d-flex justify-content-between align-items-center px-2 py-1 cursor-pointer"
                                 t-on-click="() => this.openOrdersByState('confirmed', 'Confirmed Bookings')">
                                <span class="small">Confirmed</span>
                                <span class="fw-bold small" t-out="state.booking_pipeline.confirmed"/>
                            </div>
                            <div class="o_pipe_row border-purple d-flex justify-content-between align-items-center px-2 py-1 cursor-pointer"
                                 t-on-click="() => this.openOrdersByState('invoiced', 'Invoiced Bookings')">
                                <span class="small">Invoiced</span>
                                <span class="fw-bold small" t-out="state.booking_pipeline.invoiced"/>
                            </div>
                            <div class="o_pipe_row border-green d-flex justify-content-between align-items-center px-2 py-1 cursor-pointer"
                                 t-on-click="() => this.openOrdersByState('done', 'Delivered Bookings')">
                                <span class="small">Done</span>
                                <span class="fw-bold small" t-out="state.booking_pipeline.done"/>
                            </div>
                        </div>
                    </div>

                    <!-- Pipeline Footer Split Box -->
                    <div class="o_pipe_footer d-flex justify-content-around p-2 rounded">
                        <div class="text-center cursor-pointer" t-on-click="() => this.openPendingInvoices()">
                            <div class="text-muted" style="font-size: 10px;">Pending Invoices</div>
                            <div class="fw-bold" t-out="state.booking_pipeline.pending_invoices"/>
                        </div>
                        <div class="text-center cursor-pointer" t-on-click="() => this.openDraftClearances()">
                            <div class="text-muted" style="font-size: 10px;">Pending Clearances</div>
                            <div class="fw-bold" t-out="state.booking_pipeline.pending_clearances"/>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ======================================================== -->
            <!-- 4. BOTTOM ROW: 4 OPERATIONAL CARDS                        -->
            <!-- ======================================================== -->
            <div class="o_dash_bottom_grid">

                <!-- 4.1 Recent Shipments -->
                <div class="o_dash_card h-100 p-3 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="o_card_title mb-0">Recent Shipments</h6>
                        <a href="#" class="o_view_all_link small fw-semibold" t-on-click.prevent="() => this.openAllShipments([], 'All Shipments')">View All</a>
                    </div>

                    <div class="table-responsive flex-grow-1">
                        <table class="table table-sm table-borderless o_dash_table mb-0">
                            <thead>
                                <tr>
                                    <th>Shipment</th>
                                    <th>Shipper</th>
                                    <th>Route</th>
                                    <th class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.recent_shipments and state.recent_shipments.length">
                                    <t t-foreach="state.recent_shipments" t-as="item" t-key="item.id">
                                        <tr class="cursor-pointer" t-on-click="() => this.openShipment(item.id)">
                                            <td class="fw-semibold text-truncate" style="max-width: 110px;" t-out="item.name"/>
                                            <td class="text-muted text-truncate" style="max-width: 90px;" t-out="item.shipper"/>
                                            <td class="text-muted text-truncate" style="max-width: 90px;" t-out="item.route"/>
                                            <td class="text-end">
                                                <span t-attf-class="badge rounded-pill o_badge_{{ item.state }}" t-out="item.state"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr><td colspan="4" class="text-center text-muted small py-3">No shipments found.</td></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 4.2 Recent Clearances -->
                <div class="o_dash_card h-100 p-3 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="o_card_title mb-0">Recent Clearances</h6>
                        <a href="#" class="o_view_all_link small fw-semibold" t-on-click.prevent="() => this.openAllClearances([], 'All Clearances')">View All</a>
                    </div>

                    <div class="table-responsive flex-grow-1">
                        <table class="table table-sm table-borderless o_dash_table mb-0">
                            <thead>
                                <tr>
                                    <th>Clearance</th>
                                    <th>Shipment</th>
                                    <th>Agent</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.recent_clearances and state.recent_clearances.length">
                                    <t t-foreach="state.recent_clearances" t-as="item" t-key="item.id">
                                        <tr class="cursor-pointer" t-on-click="() => this.openClearance(item.id)">
                                            <td class="fw-semibold text-truncate" style="max-width: 120px;" t-out="item.name"/>
                                            <td class="text-muted text-truncate" style="max-width: 100px;" t-out="item.shipment"/>
                                            <td class="text-muted text-truncate" style="max-width: 90px;" t-out="item.agent"/>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr><td colspan="3" class="text-center text-muted small py-3">No clearances found.</td></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 4.3 Alerts & Notifications -->
                <div class="o_dash_card h-100 p-3 d-flex flex-column">
                    <h6 class="o_card_title mb-3">Alerts &amp; Notifications</h6>

                    <div class="d-flex flex-column gap-2 flex-grow-1">
                        <!-- Alert 1: Draft Clearances -->
                        <div class="o_alert_box d-flex align-items-center gap-2 p-2 rounded cursor-pointer"
                             t-on-click="() => this.openDraftClearances()">
                            <div class="o_alert_icon_danger">
                                <i class="fa fa-exclamation"/>
                            </div>
                            <div class="o_alert_text">
                                <div class="fw-bold text-dark" style="font-size: 11px;">Custom clearances still in draft</div>
                                <div class="text-muted" style="font-size: 10px;"><t t-out="state.alerts.draft_clearances"/> record(s)</div>
                            </div>
                        </div>

                        <!-- Alert 2: Overdue Shipments -->
                        <div class="o_alert_box d-flex align-items-center gap-2 p-2 rounded cursor-pointer"
                             t-on-click="() => this.openOverdueShipments()">
                            <div class="o_alert_icon_danger">
                                <i class="fa fa-exclamation"/>
                            </div>
                            <div class="o_alert_text">
                                <div class="fw-bold text-dark" style="font-size: 11px;">Shipments past their expected date</div>
                                <div class="text-muted" style="font-size: 10px;"><t t-out="state.alerts.overdue_shipments"/> record(s)</div>
                            </div>
                        </div>

                        <t t-if="!state.alerts.draft_clearances and !state.alerts.overdue_shipments">
                            <div class="d-flex align-items-center gap-2 p-2 rounded bg-success-subtle text-success mt-auto">
                                <i class="fa fa-check-circle"/>
                                <span style="font-size: 11px;">All operations on track.</span>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- 4.4 Top Shippers -->
                <div class="o_dash_card h-100 p-3 d-flex flex-column">
                    <h6 class="o_card_title mb-3">Top Shippers</h6>

                    <div class="d-flex flex-column gap-2 flex-grow-1">
                        <t t-if="state.top_shippers and state.top_shippers.length">
                            <t t-foreach="state.top_shippers" t-as="item" t-key="item.rank">
                                <div class="o_shipper_row d-flex align-items-center justify-content-between p-2 rounded cursor-pointer"
                                     t-on-click="() => this.openPartner(item.id)">
                                    <div class="d-flex align-items-center gap-2 text-truncate me-2">
                                        <div class="o_rank_box text-center" t-out="item.rank"/>
                                        <div class="text-truncate">
                                            <div class="fw-semibold text-truncate text-dark" style="font-size: 12px;" t-out="item.name"/>
                                            <div class="text-muted" style="font-size: 10px;"><t t-out="item.count"/> shipment(s)</div>
                                        </div>
                                    </div>
                                    <div class="o_shipper_pct fw-bold" style="font-size: 11px;"><t t-out="item.percentage"/>%</div>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="text-muted small text-center my-auto">No shippers data available.</div>
                        </t>
                    </div>
                </div>

            </div>

        </div>
    </t>
</templates>
